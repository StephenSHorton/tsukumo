# Discord bot — https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=

# Live buffer size while an MCP session is open (optional)
TSUKUMO_BUFFER_SIZE=200

# --- Optional: Claude Code mod ---
# Your name on messages you type in the mod's pane (default "Me").
# TSUKUMO_YOUR_NAME=Sam
# Owner for PR references written without one ("webapp#12"); default: the
# owner of the repo linked in the channel topic.
# TSUKUMO_GITHUB_OWNER=acme
# Short names for repos, so "WEB#12" means acme/webapp.
# TSUKUMO_REPO_ALIASES=web=webapp,api=acme/api-server

# --- Optional: local HTTP serve mode only (`bun run serve`) ---
# TSUKUMO_HOST=127.0.0.1
# TSUKUMO_PORT=3847
# TSUKUMO_API_TOKEN=
